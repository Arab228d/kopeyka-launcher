{
  "name": "kopeyka-launcher",
  "version": "0.2.0-beta",
  "description": "KOPEYKA Laucher — Minecraft Java launcher for Windows",
  "main": "src/main.js",
  "author": "KOPEYKA",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test test/config.test.js test/auth.test.js test/minecraft-textures.test.js test/installer.test.js test/manifest.test.js test/mods.test.js test/launch-health.test.js test/progress-events.test.js test/shaders.test.js test/catalog-updates.test.js test/optifine.test.js test/optifine-helper.test.js test/persistence.test.js test/release-news.test.js test/news-feed.test.js test/background-catalog.test.js test/installed-content.test.js test/content-media.test.js test/catalog.test.js test/ipc-contract.test.js test/startup.test.cjs && npm run typecheck",
    "typecheck": "tsc -p tsconfig.json",
    "test:ui": "electron test/ui-smoke.cjs && electron test/ui-state.cjs",
    "build": "npm run build:installer",
    "build:installer": "npm run prepare:runtimes && electron-builder --win nsis --x64",
    "prepare:runtimes": "node scripts/prepare-runtimes.cjs && node scripts/build-optifine-helper.cjs",
    "build:optifine-helper": "node scripts/build-optifine-helper.cjs",
    "build:portable": "npm run prepare:runtimes && electron-builder --win portable --x64",
    "test:lifecycle": "electron test/lifecycle.cjs",
    "test:performance": "electron test/ui-performance.cjs",
    "test:game": "node test/game-integration.cjs"
  },
  "dependencies": {
    "adm-zip": "0.6.1",
    "minecraft-launcher-core": "3.18.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "electron": "44.9.3",
    "electron-builder": "26.15.3",
    "typescript": "^7.0.2"
  },
  "build": {
    "appId": "ru.kopeyka.launcher",
    "productName": "KOPEYKA Laucher",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!src/**/*.java"
    ],
    "win": {
      "target": "nsis",
      "signExecutable": false,
      "icon": "build/icon.ico"
    },
    "nsis": {
      "artifactName": "KOPEYKA-Laucher-Setup-${version}.exe",
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "KOPEYKA Laucher",
      "deleteAppDataOnUninstall": false,
      "installerLanguages": [
        "ru_RU"
      ],
      "runAfterFinish": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "KOPEYKA-Laucher-${version}.exe"
    },
    "extraResources": [
      {
        "from": "build/runtimes",
        "to": "runtimes",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "overrides": {
    "adm-zip": "$adm-zip",
    "request": {
      "form-data": "2.5.6",
      "qs": "6.16.1"
    }
  }
}
